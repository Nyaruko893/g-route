{
  "name": "google-ai-route-diag",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:worker": "wrangler dev --port 8787",
    "build": "vite build",
    "preview": "vite build && wrangler dev",
    "deploy": "vite build && wrangler deploy",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "knip": "knip"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "svelte": "^5.33.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261123.1",
    "@sveltejs/vite-plugin-svelte": "^5.1.0",
    "knip": "^5.59.0",
    "svelte-check": "^4.2.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.36.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "workerd"
    ]
  }
}
